# ==========================================
# QUESTDB
# ==========================================
QUESTDB_HOST=localhost
QUESTDB_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DB_NAME=qdb

# ==========================================
# KAFKA
# ==========================================
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_RAW_TRADES=raw-trades
KAFKA_TOPIC_KLINE_STREAM=kline-stream
KAFKA_CONSUMER_GROUP_ID=candle-processor-group
KAFKA_AUTO_OFFSET_RESET=earliest

# ==========================================
# BINANCE & PIPELINE
# ==========================================
BINANCE_SOCKET_URL=wss://stream.binance.com:9443/stream
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
CANDLE_INTERVALS=1m,3m,5m,15m,30m,1h,2h,4h,6h,8h,12h,1d,3d,1w,1M
CANDLE_UPDATE_INTERVAL_MS=500

# ==========================================
# STARTUP RECONCILIATION
# ==========================================
STARTUP_RECONCILE_ENABLED=true
STARTUP_RECONCILE_REQUIRED=true
STARTUP_RECONCILE_MAX_ATTEMPTS=3
STARTUP_RECONCILE_RETRY_DELAY_SECONDS=5
STARTUP_RECONCILE_SYMBOLS=
STARTUP_RECONCILE_DRY_RUN=false
STARTUP_RECONCILE_KEEP_TEMP=false
STARTUP_RECONCILE_BINANCE_REST_URL=https://api.binance.com
STARTUP_RECONCILE_TOLERANCE=0.00000001
STARTUP_RECONCILE_WINDOW_HOURS=24
STARTUP_RECONCILE_END_LAG_MINUTES=2
STARTUP_BACKFILL_STATE_FILE=
